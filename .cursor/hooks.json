{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node scripts/agent/hooks/block-env-edits.mjs",
        "matcher": "edit_file|create_file"
      }
    ],
    "stop": [
      {
        "command": "node scripts/agent/hooks/cursor-stop.mjs",
        "timeout": 120
      }
    ]
  }
}
