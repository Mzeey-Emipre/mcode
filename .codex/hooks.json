{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hooks/block-env-edits.mjs --codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/hooks/codex-stop.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
