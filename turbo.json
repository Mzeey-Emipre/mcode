{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/vitest-test-dir.ts",
        "../../scripts/vitest-global-setup.ts",
        "../../scripts/run-electron-node.mjs",
        "../../scripts/kill-process-tree.mjs"
      ]
    },
    "mcode-desktop#test": {
      "dependsOn": ["transit", "@mcode/server#transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/vitest-test-dir.ts",
        "../../scripts/vitest-global-setup.ts",
        "../../scripts/run-electron-node.mjs",
        "../../scripts/kill-process-tree.mjs",
        "../../scripts/build-server-dev-bundle.mjs"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": ["node_modules/.cache/tsbuildinfo"]
    },
    "lint": {}
  }
}
