{
  "name": "mcode",
  "version": "0.12.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/desktop",
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "node scripts/setup-env.mjs",
    "install:electron": "node scripts/ensure-electron.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev-web.mjs",
    "dev:desktop": "cd apps/desktop && bun run dev",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:server": "cd apps/server && bun run start",
    "prod:desktop": "cd apps/desktop && bun run prod",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "logs:tail": "node scripts/logs-tail.mjs",
    "state:paths": "bun scripts/state-paths.mjs",
    "state:reset": "node scripts/state-reset.mjs",
    "db:info": "bun scripts/db-info.mjs",
    "agent:up": "node scripts/agent/agent-up.mjs",
    "agent:down": "node scripts/agent/agent-down.mjs",
    "agent:reset": "node scripts/agent/agent-reset.mjs",
    "sync:cursor-models": "bun apps/server/scripts/sync-cursor-models-snapshot.ts",
    "verify": "node scripts/agent/verify-tests.mjs --full",
    "verify:changed": "node scripts/agent/verify-tests.mjs",
    "verify:e2e": "node scripts/agent/verify-e2e.mjs",
    "verify:all": "node scripts/agent/verify-all.mjs",
    "audit:baseline": "node scripts/security/check-bun-audit-baseline.mjs",
    "test:scripts": "node --test scripts/agent/__tests__/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "esbuild": "^0.27.7",
    "turbo": "^2.5.0"
  },
  "packageManager": "bun@1.2.14",
  "trustedDependencies": [
    "electron",
    "electron-mksnapshot",
    "node-pty",
    "@electron/rebuild"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.212"
  }
}
